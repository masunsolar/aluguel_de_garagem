# Neon: copie a connection string em Neon > Connect (use a "pooled", com sslmode=require)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Gere com:  npm run hash-password -- "sua senha longa"   (cole a linha inteira aqui)
ADMIN_PASSWORD_HASH=scrypt:...:...
# Gere com:  openssl rand -base64 48   (mínimo 32 caracteres)
AUTH_SECRET=
